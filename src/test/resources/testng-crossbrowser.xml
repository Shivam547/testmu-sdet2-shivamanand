<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Cross-Browser Test Suite Configuration
    Runs UI tests on multiple browsers: Chrome, Firefox, Edge
    Usage: mvn test -DsuiteXmlFile=src/test/resources/testng-crossbrowser.xml
-->
<suite name="TestMu SDET2 - Cross Browser Test Suite" 
       parallel="tests" 
       thread-count="3"
       verbose="2">
    
    <listeners>
        <listener class-name="com.testmu.listeners.TestListener"/>
    </listeners>
    
    <!-- Chrome Browser Tests -->
    <test name="Cross-Browser - Chrome">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.testmu.tests.ui.CrossBrowserTest"/>
            <class name="com.testmu.tests.ui.LoginTest">
                <methods>
                    <include name="testValidLogin"/>
                    <include name="testLogout"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- Firefox Browser Tests -->
    <test name="Cross-Browser - Firefox">
        <parameter name="browser" value="firefox"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.testmu.tests.ui.CrossBrowserTest"/>
            <class name="com.testmu.tests.ui.LoginTest">
                <methods>
                    <include name="testValidLogin"/>
                    <include name="testLogout"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- Edge Browser Tests -->
    <test name="Cross-Browser - Edge">
        <parameter name="browser" value="edge"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.testmu.tests.ui.CrossBrowserTest"/>
            <class name="com.testmu.tests.ui.LoginTest">
                <methods>
                    <include name="testValidLogin"/>
                    <include name="testLogout"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- Headless Chrome Tests (for CI/CD) -->
    <test name="Cross-Browser - Chrome Headless">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.testmu.tests.ui.CrossBrowserTest"/>
        </classes>
    </test>
    
    <!-- Headless Firefox Tests (for CI/CD) -->
    <test name="Cross-Browser - Firefox Headless">
        <parameter name="browser" value="firefox"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.testmu.tests.ui.CrossBrowserTest"/>
        </classes>
    </test>
    
</suite>
