<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Main TestNG Suite Configuration
    Runs all tests: UI, API, and Integration tests
    Usage: mvn test -DsuiteXmlFile=src/test/resources/testng.xml
-->
<suite name="TestMu SDET2 - Complete Test Suite" 
       parallel="classes" 
       thread-count="3"
       verbose="2">
    
    <!-- Global listeners -->
    <!-- testng.xml listeners order -->
    <listeners>
    <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    <listener class-name="com.testmu.listeners.TestListener"/>
    </listeners>
    
    <!-- Test parameters - can be overridden at test level -->
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>
    
    <!-- UI Tests -->
    <test name="UI Tests - Authentication">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.ui.LoginTest"/>
        </classes>
    </test>
    
    <test name="UI Tests - Form Validation">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.ui.FormValidationTest"/>
        </classes>
    </test>

    <test name="UI Tests - Dashboard">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.ui.DashboardTest"/>
        </classes>
    </test>
    
    <!-- API Tests -->
    <test name="API Tests - CRUD Operations">
        <classes>
            <class name="com.testmu.tests.api.CrudApiTest"/>
        </classes>
    </test>
    
    <test name="API Tests - Authentication">
        <classes>
            <class name="com.testmu.tests.api.AuthApiTest"/>
        </classes>
    </test>
    
    <test name="API Tests - Error Handling">
        <classes>
            <class name="com.testmu.tests.api.ErrorHandlingTest"/>
        </classes>
    </test>
    
    <test name="API Tests - Schema Validation">
        <classes>
            <class name="com.testmu.tests.api.SchemaValidationTest"/>
        </classes>
    </test>
    
    <!-- Integration Tests -->
    <test name="Integration Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.integration.PetstoreApiUiIntegrationTest"/>
        </classes>
    </test>
    
</suite>
