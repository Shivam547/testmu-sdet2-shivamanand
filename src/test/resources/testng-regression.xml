<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Regression Test Suite Configuration
    Comprehensive test suite - runs all tests excluding known flaky ones
    Usage: mvn test -DsuiteXmlFile=src/test/resources/testng-regression.xml
-->
<suite name="TestMu SDET2 - Regression Test Suite" 
       parallel="classes" 
       thread-count="5"
       verbose="2">
    
    <listeners>
        <listener class-name="com.testmu.listeners.TestListener"/>
    </listeners>
    
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>
    
    <!-- All UI Tests -->
    <test name="Regression - UI Login Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.ui.LoginTest"/>
        </classes>
    </test>
    
    <test name="Regression - UI Form Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.ui.FormValidationTest"/>
        </classes>
    </test>

    <test name="Regression - UI Dashboard Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.ui.DashboardTest"/>
        </classes>
    </test>
    
    <!-- All API Tests -->
    <test name="Regression - API CRUD Tests">
        <classes>
            <class name="com.testmu.tests.api.CrudApiTest"/>
        </classes>
    </test>
    
    <test name="Regression - API Auth Tests">
        <classes>
            <class name="com.testmu.tests.api.AuthApiTest"/>
        </classes>
    </test>
    
    <test name="Regression - API Error Tests">
        <classes>
            <class name="com.testmu.tests.api.ErrorHandlingTest"/>
        </classes>
    </test>
    
    <test name="Regression - API Schema Tests">
        <classes>
            <class name="com.testmu.tests.api.SchemaValidationTest"/>
        </classes>
    </test>
    
    <!-- All Integration Tests -->
    <test name="Regression - Integration Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.testmu.tests.integration.PetstoreApiUiIntegrationTest"/>
        </classes>
    </test>
    
</suite>
