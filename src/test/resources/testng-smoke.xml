<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Smoke Test Suite Configuration
    Quick validation tests - high priority, critical path tests only
    Usage: mvn test -DsuiteXmlFile=src/test/resources/testng-smoke.xml
-->
<suite name="TestMu SDET2 - Smoke Test Suite" 
       parallel="classes" 
       thread-count="2"
       verbose="2">
    
    <listeners>
        <listener class-name="com.testmu.listeners.TestListener"/>
    </listeners>
    
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>
    
    <!-- Critical UI Smoke Tests -->
    <test name="Smoke - UI Authentication">
        <classes>
            <class name="com.testmu.tests.ui.LoginTest">
                <methods>
                    <include name="testValidLogin"/>
                    <include name="testLogout"/>
                    <include name="testLoginPageElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Smoke - UI Dashboard">
        <classes>
            <class name="com.testmu.tests.ui.DashboardTest">
                <methods>
                    <include name="testDashboardElementsDisplayed"/>
                    <include name="testSessionPersistsOnRefresh"/>
                    <include name="testLogoutClearsSession"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- Critical API Smoke Tests -->
    <test name="Smoke - API CRUD">
        <classes>
            <class name="com.testmu.tests.api.CrudApiTest">
                <methods>
                    <include name="testGetAllPosts"/>
                    <include name="testGetPostById"/>
                    <include name="testCreatePost"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- Critical Integration Smoke Tests -->
    <test name="Smoke - Integration">
        <classes>
            <class name="com.testmu.tests.integration.PetstoreApiUiIntegrationTest">
                <methods>
                    <include name="testApiDataSetupForUI"/>
                </methods>
            </class>
        </classes>
    </test>
    
</suite>
